# infra/terraform.tfvars — 이 파일을 복사해서 채운다. 비밀값이 아니므로 프로젝트에서는 커밋한다.
#
#   cp infra/terraform.tfvars.example infra/terraform.tfvars
#
# ⚠️ 키·토큰은 여기 적지 않는다 → infra/.env

project        = "myapp"        # 소문자·숫자·하이픈. 리소스 이름 접두사
aws_account_id = "123456789012" # infra/.env 의 키가 이 계정 것이 아니면 멈춘다
domain         = "example.com"  # 스킴 없이. CORS·쿠키·nginx·OAuth 리다이렉트가 여기서 나온다

# instance_type = "t3.small"
# volume_size   = 20
