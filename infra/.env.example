# ══════════════════════════════════════════════════════════════
#  infra/.env  —  Terraform 이 쓰는 키. 이 파일을 .env 로 복사해서 채운다.
#
#    cp infra/.env.example infra/.env
#
#  tf.ps1 / tf.sh 가 읽어서 환경변수로 넘긴다 (terraform 을 직접 부르면 안 읽힌다).
#  폴더마다 자기 파일이 있으니 AWS 계정이 여러 개여도 섞이지 않는다.
#
#  ⚠️ backend/.env 와 합치지 말 것. 그 파일은 서버로 가고, 이 키는 계정 전체 권한이다.
#     서버는 키 없이 IAM Role 로, GitHub Actions 는 OIDC 로 권한을 받는다.
#  ⚠️ git 에는 안 올라간다 (루트 .gitignore 의 `.env`).
# ══════════════════════════════════════════════════════════════

# ── AWS ───────────────────────────────────────────────────────
# IAM → 사용자 → 보안 자격 증명 → 액세스 키 만들기.
# terraform.tfvars 의 aws_account_id 와 다른 계정 키면 plan 에서 멈춘다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# ── Cloudflare ────────────────────────────────────────────────
# My Profile → API Tokens → Create Token → Custom token.
# 권한 (Zone Resources 는 "Specific zone → 이 도메인" 만):
#   Zone · Zone · Read / Zone · DNS · Edit / Zone · SSL and Certificates · Edit / Zone · Zone Settings · Edit
# bootstrap 에는 필요 없다. 그 외 명령은 이게 비어 있으면 멈춘다
CLOUDFLARE_API_TOKEN=
