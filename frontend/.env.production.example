# ══════════════════════════════════════════════════════════════
#  frontend/.env.production  —  npm run build 시 .env 대신 읽힌다.
#
#    cp frontend/.env.production.example frontend/.env.production
#
#  Vite는 .env를 먼저 읽고 .env.production을 덮어씌운다 (키 단위 병합).
#  그래서 여기엔 운영에서 "달라지는 키"만 적으면 되고, 나머지는 .env 값이
#  그대로 쓰인다. 단, 빌드 머신에 .env가 없다면 전부 여기 적어야 한다.
# ══════════════════════════════════════════════════════════════

VITE_APP_PUBLIC_BASE_URL=https://api.example.com

VITE_APP_PUBLIC_KAKAO_REDIRECT_URI=https://example.com/kakao/login
VITE_APP_PUBLIC_GOOGLE_REDIRECT_URI=https://example.com/google/login

# OAuth 키는 local/prod가 같은 앱이면 .env 값이 그대로 상속된다.
# 운영용 앱을 따로 팠거나 빌드 머신에 .env가 없으면 아래 주석을 풀 것.
# VITE_APP_PUBLIC_KAKAO_REST_API_KEY=
# VITE_APP_PUBLIC_GOOGLE_CLIENT_ID=
