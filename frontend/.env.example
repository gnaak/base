# ══════════════════════════════════════════════════════════════
#  frontend/.env  —  이 파일을 .env로 복사해서 값을 채운다.
#
#    cp frontend/.env.example frontend/.env
#
#  Vite는 VITE_ 접두사가 붙은 것만 클라이언트에 노출한다.
#  ⚠️ 여기 값은 전부 번들에 그대로 박혀서 브라우저에서 보인다.
#     client_secret 류는 절대 넣지 말 것 — 백엔드 .env로.
# ══════════════════════════════════════════════════════════════

# ── API 서버 ──────────────────────────────────────────────────
# 백엔드 오리진. 쿠키 세션이라 프론트와 호스트를 통일해야 한다
# (localhost끼리 또는 127.0.0.1끼리 — 섞으면 cross-site가 돼서 쿠키가 안 실린다).
VITE_APP_PUBLIC_BASE_URL=http://localhost:8000

# ── OAuth: Kakao ──────────────────────────────────────────────
# REST API 키. 백엔드 kakao_client_id와 같은 값.
# redirect_uri는 백엔드 local_kakao_redirect_uri와 정확히 일치해야 한다.
VITE_APP_PUBLIC_KAKAO_REST_API_KEY=
VITE_APP_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/kakao/login

# ── OAuth: Google ─────────────────────────────────────────────
# 백엔드 google_client_id / local_google_redirect_uri와 같은 값.
VITE_APP_PUBLIC_GOOGLE_CLIENT_ID=
VITE_APP_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/google/login
