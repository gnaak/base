# systemd 유닛. gunicorn + UvicornWorker 로 FastAPI 를 띄운다.
#
#   sudo cp deploy/fastapi.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fastapi
#   sudo journalctl -u fastapi -f        # 기동 로그 확인
#
# ⚠️ 바꿀 곳은 User / WorkingDirectory / 경로뿐이다 (CHANGE 표시).

[Unit]
Description=FastAPI (base backend)
# network-online 은 "IP 가 붙은 뒤" 를 뜻한다. network.target 만으로는
# 부팅 직후 DB 에 못 붙어 fail-fast 로 죽는 일이 생긴다.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu                                     # CHANGE
Group=ubuntu                                    # CHANGE
WorkingDirectory=/srv/example/backend           # CHANGE

# ══════════════════════════════════════════════════════════════
#  APP_ENV — 이 줄이 없으면 배포 사고가 난다
# ══════════════════════════════════════════════════════════════
# settings 는 APP_ENV 가 없으면 **호스트명으로 추측한다.** 그 추측은 EC2 기본
# 호스트명(ip-/ec2-)에서만 맞는다. 호스트명을 바꾸거나 다른 환경으로 옮기면
# 조용히 local 로 떨어져서 쿠키가 secure=False 로 나가고 세션이 안 잡힌다.
#
# 기동 로그에 `설정: env=prod (근거: APP_ENV)` 가 찍히는지 확인할 것.
# `근거: hostname 추측` 이면 운에 기대고 있는 상태다.
Environment="APP_ENV=prod"
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/srv/example/backend/.venv/bin"    # CHANGE

# .env 를 유닛에서 읽고 싶다면 (선택):
#   EnvironmentFile=/srv/example/backend/.env
# 다만 이 템플릿은 pydantic-settings 가 .env 를 직접 읽으므로 보통 불필요하다.
# (APP_ENV 만은 예외 — os.getenv 로 읽으므로 .env 에 적어도 먹지 않는다)

# gunicorn 은 pyproject.toml 의 `prod` 그룹에 있다. 배포 시
#   uv sync --frozen --no-dev --group prod
# 를 돌려야 이 경로에 생긴다 (`--group prod` 를 빠뜨리면 유닛이 기동 실패한다).
ExecStart=/srv/example/backend/.venv/bin/gunicorn app.main:app \
    -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --workers 1 \
    --timeout 0 \
    --graceful-timeout 30 \
    --forwarded-allow-ips="127.0.0.1" \
    --access-logfile -

# ── 위 옵션들에 대하여 ─────────────────────────────────────────
#
# --bind 127.0.0.1  앱을 외부에 직접 노출하지 않는다. nginx 만 붙는다.
#                   0.0.0.0 으로 바꾸면 아래 forwarded-allow-ips 가 구멍이 된다.
#
# --workers 1       ⚠️ 올리지 말 것. 파일 로그 로테이션이 프로세스끼리 충돌한다
#                   (core/logging/config.py 주석 참고). 처리량이 필요하면
#                   **먼저** 파일 핸들러를 stdout 수집으로 바꾸고 나서 올린다.
#                   그러면 --access-logfile 도 빼고 journald 가 받게 한다.
#
# --timeout 0       UvicornWorker + SSE/WebSocket 조합에서 gunicorn 이 스트리밍
#                   중인 워커를 죽이는 문제를 피한다. 대신 **행 걸린 워커를
#                   자동으로 못 죽인다** — workers 가 1이면 단일 장애점이므로,
#                   스트리밍을 안 쓰는 프로젝트라면 60~120 으로 두는 편이 낫다.
#
# --graceful-timeout 30   재시작 시 진행 중 요청을 30초까지 기다린다.
#                   0 으로 두면 배포할 때마다 요청이 끊긴다.
#
# --forwarded-allow-ips   이 IP 가 보낸 X-Forwarded-* 만 믿는다.
#                   "*" 로 열면 아무나 보낸 헤더를 신뢰하게 되어,
#                   앱이 외부에 노출되는 순간 레이트리밋이 통째로 우회된다.

Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal

# ── 최소 권한 ─────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# 앱이 써야 하는 곳만 열어준다 (로그·업로드)
ReadWritePaths=/srv/example/backend/logs /srv/example/backend/media   # CHANGE

[Install]
WantedBy=multi-user.target
