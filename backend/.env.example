# ══════════════════════════════════════════════════════════════
#  backend/.env  —  이 파일을 .env로 복사해서 값을 채운다.
#
#    cp backend/.env.example backend/.env
#
#  여기 적힌 키는 전부 app/core/config/settings.py 의 RawEnv가 읽는다.
#  값은 {env}_ 접두사로 local / prod 두 벌을 두고, APP_ENV가 고른다.
#
#  ⚠️ APP_ENV는 이 파일에 적어도 먹지 않는다.
#     settings.py가 os.getenv("APP_ENV")로 읽는데, pydantic-settings는
#     .env를 os.environ에 넣지 않는다. 반드시 실제 환경변수로 줄 것:
#       APP_ENV=prod uvicorn app.main:app ...
# ══════════════════════════════════════════════════════════════

# ── MySQL ─────────────────────────────────────────────────────
# port는 local/prod 공용.
mysql_port=3306

local_mysql_user=root
local_mysql_password=
local_mysql_host=127.0.0.1
local_mysql_db=db_example

# 로컬만 돌릴 거면 비워둬도 기동된다 (prod로 뜰 때만 필요).
prod_mysql_user=
prod_mysql_password=
prod_mysql_host=
prod_mysql_db=

# pytest 전용 DB. 접속 정보는 local_* 을 그대로 쓰고 이름만 이걸로 바꾼다.
# ⚠️ 테스트가 매번 테이블을 drop 하므로 local/prod 와 절대 같은 이름을 주지 말 것
#    (같으면 conftest 가 기동 시점에 막는다). 최초 1회: CREATE DATABASE db_base_test;
test_mysql_db=db_base_test

# ── Redis ─────────────────────────────────────────────────────
# host/port는 필수, password는 없으면 비워둔다.
local_redis_host=localhost
local_redis_port=6379
local_redis_password=

prod_redis_host=
prod_redis_port=6379
prod_redis_password=

# ── 시크릿 ────────────────────────────────────────────────────
# ⚠️ 프로젝트마다 반드시 새로 생성할 것. 템플릿 값을 그대로 쓰면
#    다른 프로젝트에서 발급한 토큰이 이 서비스에서도 통과한다.
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
jwt_secret=
hash_key=

# ── 토큰 수명 ──────────────────────────────────────────────────
# access_token_minutes = 무효화(로그아웃·비번변경·계정정지)가 적용되기까지의 **지연**.
#   무효화 확인을 refresh 시점에만 하므로 이 값이 곧 최대 지연이 된다.
#   "access는 15~30분" 권고의 근거가 이것이다.
# refresh_token_hours  = 재로그인 없이 세션이 유지되는 기간.
#
#   성격                access   refresh
#   관리자 도구·내부     15~30분   8~12시간   (12)
#   일반 웹 서비스       15~30분   3~14일     (72 ~ 336)
#   금융·의료           5~15분    30분~2시간  (1~2)
#
# refresh에는 로테이션 + 재사용 탐지가 걸려 있어서(module/auth/auth_revoke.py)
# 며칠 단위로 잡아도 된다 — 갱신할 때마다 옛 토큰이 죽고, 죽은 토큰이 다시 오면
# 유출로 보고 그 계정의 모든 세션을 끊는다.
access_token_minutes=30
refresh_token_hours=168

# ── 외부 API ──────────────────────────────────────────────────
# 선택. 비워두면 해당 기능만 죽고 서버는 정상 기동한다.
openai_api_key=

# ── OAuth: Kakao ──────────────────────────────────────────────
# redirect_uri는 카카오 개발자 콘솔에 등록한 값과 정확히 일치해야 한다.
kakao_client_id=
kakao_client_secret=
local_kakao_redirect_uri=http://localhost:3000/kakao/login
prod_kakao_redirect_uri=

# ── OAuth: Google ─────────────────────────────────────────────
google_client_id=
google_client_secret=
local_google_redirect_uri=http://localhost:3000/google/login
prod_google_redirect_uri=

# ── 도메인 (CORS 오리진 + 쿠키 도메인을 여기서 함께 유도) ──────
# - 쉼표로 여러 개. 스킴(http/https)은 쓰지 않는다 — env에 따라 자동으로 붙는다
#   (local→http, prod→https).
# - CORS는 포트를 따지므로 `localhost:3000`처럼 포트까지 적는다.
# - 앞에 점을 찍으면(.example.com) 쿠키를 서브도메인까지 공유한다.
#   점이 없으면 host-only — 범위가 제일 좁아 안전하고, 대부분 이게 맞다.
local_domain=localhost:3000,127.0.0.1:3000
prod_domain=

# ── 쿠키 SameSite (lax | strict | none) ───────────────────────
# **lax 가 곧 CSRF 방어다.** 브라우저가 cross-site 요청에 쿠키를 붙이지 않으므로,
# 악성 사이트가 사용자의 브라우저를 시켜 이 API를 호출해도 인증이 안 된다.
#
# none 은 그 방어를 끄는 값이다. 프론트와 백엔드가 **다른 사이트**일 때만 쓴다
# (Vercel + 별도 API 도메인, 서드파티 iframe 임베드 등).
# 이 템플릿의 인증은 프론트 JS가 user_info 쿠키를 직접 읽는 구조라 원래 same-site를
# 전제하므로, 프론트·백엔드를 같은 호스트에 올렸다면 lax 그대로 두면 된다.
#
# ⚠️ none 은 HTTPS(secure)가 함께 있어야 브라우저가 받아준다.
#    그리고 켜는 순간 CSRF 토큰이나 Origin 검증을 따로 붙여야 한다.
#    (기동 로그에 경고가 뜬다)
cookie_samesite=lax
